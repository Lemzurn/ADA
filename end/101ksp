def zero_one_knapsack():
    print("--- 0/1 Knapsack Problem (Dynamic Programming) ---")
    n = int(input("Enter the number of items: "))
    
    print("Enter the weights of the items separated by spaces:")
    wt = list(map(int, input().split()))
    
    print("Enter the values of the items separated by spaces:")
    val = list(map(int, input().split()))
    
    W = int(input("Enter the total capacity of the knapsack: "))
    
    # Initialize DP table with 0s
    dp = [[0 for _ in range(W + 1)] for _ in range(n + 1)]
    
    # Build the table in bottom-up manner
    for i in range(1, n + 1):
        for w in range(1, W + 1):
            if wt[i-1] <= w:
                # Max of including the item OR not including it
                dp[i][w] = max(val[i-1] + dp[i-1][w-wt[i-1]], dp[i-1][w])
            else:
                # Item is too heavy, skip it
                dp[i][w] = dp[i-1][w]
                
    print(f"\nMaximum total value in the knapsack: {dp[n][W]}")

zero_one_knapsack()
