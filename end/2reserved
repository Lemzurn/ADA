%{
#include <stdio.h>
%}

%%
"int"|"float"|"char"|"double"|"void"|"if"|"else"|"while"|"for"|"return"  { printf("%s: Reserved word\n", yytext); }
[a-zA-Z_][a-zA-Z0-9_]* { printf("%s: Identifier\n", yytext); } /* Matches standard C variable names */
[0-9]+                  { printf("%s: Number\n", yytext); }
[ \t\n]+                ; /* Ignore whitespace */
.                       ; 
%%

int yywrap() { return 1; }

int main() {
    printf("Enter C code:\n");
    yylex();
    return 0;
}


lex filename.l
gcc lex.yy.c -o filename
./filename
